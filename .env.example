# 默认单用户本地服务
PORT=3000
HOST=127.0.0.1
DATA_DIR=.data
# ACCESS_TOKEN=
# DATABASE_URL=postgresql://learning_user@127.0.0.1:5432/learning

# 兼容 OpenAI Chat Completions 的模型，需支持 JSON Schema 与 temperature
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=https://api.openai.com/v1

# 可选：兼容 OpenAI Embeddings 的语义检索模型（未单独设置密钥或地址时复用 AI_API_KEY / AI_BASE_URL）
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_BASE_URL=

# 可选：AI 联网搜索工具（默认 duckduckgo 免密钥，可选 tavily / brave / serper / searxng / custom）
# AI_SEARCH_PROVIDER=duckduckgo
# AI_SEARCH_API_KEY=
# AI_SEARCH_BASE_URL=

# 程序需已安装；也可填写绝对路径
# YT_DLP=yt-dlp
# WHISPER_PYTHON=.venv/bin/python
# WHISPER_MODEL=small
